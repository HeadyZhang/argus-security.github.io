{
  "name": "voice-beta-signups",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "send_metrics": false,
  "observability": { "enabled": false },
  "vars": { "ALLOWED_ORIGINS": "https://argus-security.dev" },
  "d1_databases": [{ "binding": "DB", "database_name": "voice-beta-signups", "database_id": "d0565ff1-ac51-4ce5-b496-934a1405d6cc" }],
  "ratelimits": [{ "name": "SIGNUP_LIMITER", "namespace_id": "2026100601", "simple": { "limit": 5, "period": 60 } }],
  "env": {
    "local": {
      "name": "voice-beta-signups-local",
      "vars": { "ALLOWED_ORIGINS": "http://127.0.0.1:4173,http://localhost:4173" },
      "d1_databases": [{ "binding": "DB", "database_name": "voice-beta-local", "database_id": "00000000-0000-0000-0000-000000000001" }],
      "ratelimits": [{ "name": "SIGNUP_LIMITER", "namespace_id": "2026100602", "simple": { "limit": 5, "period": 60 } }]
    }
  }
}
